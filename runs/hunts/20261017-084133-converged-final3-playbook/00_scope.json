    "templates": {
      "windows-powershell": {
        "dataset": "windows.powershell",
        "origin": "generated",
        "description": "Windows PowerShell event log records (Microsoft-Windows-PowerShell/Operational and Windows PowerShell channels) exported as flat NXLog JSON (im_msvistalog). Keeps every original field under win.*, maps the common ones to ECS.",
        "match": {
          "format": "json",
          "required_keys": [
            "Channel",
            "EventID",
            "Hostname",
            "EventTime"
          ],
          "equals": {
            "Channel": [
              "Microsoft-Windows-PowerShell/Operational",
              "Windows PowerShell"
            ]
          }
        }
      },
      "windows-other": {
        "dataset": "windows.other",
        "origin": "generated",
        "description": "Windows event log records from non-Security, non-Sysmon channels (WMI-Activity, System, TerminalServices, Firewall, etc.) exported as flat NXLog JSON (im_msvistalog). Keeps every original field under win.*, maps the common ones to ECS.",
        "match": {
          "format": "json",
          "required_keys": [
            "Channel",
            "EventID",
            "Hostname",
            "EventTime"
          ],
          "equals": {
            "Channel": [
              "Microsoft-Windows-WMI-Activity/Operational",
              "System",
              "Microsoft-Windows-TerminalServices-RemoteConnectionManager/Operational",
              "Microsoft-Windows-Windows Firewall With Advanced Security/Firewall",
              "Microsoft-Windows-TerminalServices-LocalSessionManager/Operational"
            ]
          }
        }
      },
      "zeek": {
        "dataset": "zeek",
        "origin": "generated",
        "description": "Zeek network sensor logs in JSON format (conn, dns, http, files, ssl, dhcp, notice, etc.). Keeps every original field under zeek.*, maps common fields to ECS. observer.name is the sensor (@system).",
        "match": {
          "format": "json",
          "required_keys": [
            "@proc",
            "ts"
          ],
          "equals": {
            "@proc": [
              "zeek"
            ]
          }
        }
      },
      "windows-sysmon": {
        "dataset": "windows.sysmon",
        "origin": "builtin",
        "description": "Sysmon (Microsoft-Windows-Sysmon/Operational) records exported as flat NXLog JSON (im_msvistalog). Keeps every original field under win.*, maps the common ones to ECS.",
        "match": {
          "format": "json",
          "required_keys": [
            "Channel",
            "EventID",
            "Hostname",
            "EventTime"
          ],
          "equals": {
            "Channel": [
              "Microsoft-Windows-Sysmon/Operational"
            ]
          }
        }
      },
      "windows-security": {
        "dataset": "windows.security",
        "origin": "builtin",
        "description": "Windows Security audit log records exported as flat NXLog JSON (im_msvistalog), either channel spelling (Security / security). Keeps every original field under win.*, maps the common ones to ECS.",
        "match": {
          "format": "json",
          "required_keys": [
            "Channel",
            "EventID",
            "Hostname",
            "EventTime"
          ],
          "equals": {
            "Channel": [
              "Security",
              "security"
            ]
          }
        }
      }
    }
