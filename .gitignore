# Secrets and local state
.env
elk/certs/

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Downloaded datasets and generated data (large, re-downloadable)
data/
# copies of the sources delivered through the pull channel
dropzone/*
!dropzone/.gitkeep
# produced by running the system (ingest logs, onboarding transcripts, hunt reports, comparisons, MCP audit logs)
runs/
# templates the onboarding agent creates at run time; every rebuild deletes them and the agent creates them again
templates/generated/*
!templates/generated/.gitkeep
# source registry, filled by the onboarding agent; the setup container creates empty files on a fresh checkout
registry/*
!registry/.gitkeep

# Editor / OS
.vscode/
.idea/
Thumbs.db
.DS_Store
