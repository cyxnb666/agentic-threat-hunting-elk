# Copy to .env. scripts/init-env.ps1 does this and fills every empty *_PASSWORD with a random value.
# .env is gitignored.

# Keeps this stack's containers/volumes separate from any other compose project on this machine
COMPOSE_PROJECT_NAME=agentic-hunt

# --- Elastic Stack ---
# 9.5.5 = latest released 9.x (GitHub release v9.5.5, 2026-10-06; images exist on docker.elastic.co)
STACK_VERSION=9.5.5
CLUSTER_NAME=hunt-cluster
LICENSE=basic

# Passwords: alphanumeric only, at least 6 characters (requirement stated in the official compose example)
ELASTIC_PASSWORD=
KIBANA_PASSWORD=
LOGSTASH_WRITER_PASSWORD=
# onboarding agent (manages parsing templates) and MCP server (read-only)
HUNT_AGENT_PASSWORD=
HUNT_MCP_PASSWORD=
# basic-auth password endpoint agents use for the push channel (Logstash http input, user "endpoint")
PUSH_PASSWORD=

# Bind to localhost only (the official .env offers ES_PORT=127.0.0.1:9200 for this)
ES_PORT=127.0.0.1:9200
KIBANA_PORT=127.0.0.1:5601

# Memory limits. Docker Desktop has ~11.7 GB on this host; 4 + 2 + 3 = 9 GB leaves headroom.
ES_MEM_LIMIT=4g
KIBANA_MEM_LIMIT=2g
LS_MEM_LIMIT=3g
LS_JAVA_OPTS=-Xms2g -Xmx2g

# --- LLM (DeepSeek, OpenAI-compatible API; base URL and model names from api-docs.deepseek.com) ---
# Fill in yourself. Never commit this value.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
